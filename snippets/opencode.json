{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context-web-search": {
      "type": "local",
      "command": ["context-kit", "web-search"],
      "enabled": true,
      "timeout": 60000
    },
    "context-docs": {
      "type": "local",
      "command": ["context-kit", "docs"],
      "enabled": true,
      "timeout": 120000
    },
    "context-repomix": {
      "type": "local",
      "command": ["context-kit", "repomix"],
      "enabled": true,
      "timeout": 120000
    }
  }
}
