{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context-web-search": {
      "type": "remote",
      "url": "http://127.0.0.1:8777/mcp",
      "enabled": true,
      "timeout": 150000
    },
    "context-docs": {
      "type": "remote",
      "url": "http://127.0.0.1:8776/mcp",
      "enabled": true,
      "timeout": 150000
    },
    "context-repomix": {
      "type": "local",
      "command": ["context-kit", "repomix"],
      "enabled": true,
      "timeout": 120000
    }
  }
}
